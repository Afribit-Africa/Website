# =============================================================================
# AFRIBIT AFRICA - Environment Variables Template
# =============================================================================
# Copy this file to .env.local and fill in your actual values
# Never commit .env.local to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# MySQL database connection string
# Format: mysql://user:password@host:port/database
DATABASE_URL=mysql://username:password@localhost:3306/afribit_db

# -----------------------------------------------------------------------------
# BTCPAY SERVER CONFIGURATION
# -----------------------------------------------------------------------------
# BTCPay Server host URL (your instance or hosted)
BTCPAY_HOST=https://pay.afribit.africa

# BTCPay Store ID (found in Store Settings > General)
BTCPAY_STORE_ID=your_store_id_here

# BTCPay API Key (created in Account Settings > API Keys)
# Required permissions: View invoices, Create invoices, View stores
BTCPAY_API_KEY=your_btcpay_api_key_here

# -----------------------------------------------------------------------------
# EMAIL CONFIGURATION (RESEND)
# -----------------------------------------------------------------------------
# Resend API Key (get from https://resend.com/api-keys)
# Used for transactional emails (donations, merchant approvals, etc.)
RESEND_API_KEY=re_your_resend_api_key_here

# Site URL for email links (production URL)
NEXT_PUBLIC_SITE_URL=https://afribit.africa

# Admin notification email address
# Receives alerts for new merchant submissions
ADMIN_NOTIFICATION_EMAIL=info@afribit.africa

# -----------------------------------------------------------------------------
# EMAIL CONFIGURATION (SMTP FALLBACK)
# -----------------------------------------------------------------------------
# SMTP server configuration (Hostinger, Gmail, etc.)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true

# SMTP authentication credentials
SMTP_USER=info@afribit.africa
SMTP_PASSWORD=your_smtp_password_here

# Email sender details
EMAIL_FROM=info@afribit.africa
EMAIL_FROM_NAME=Afribit Africa

# Set to 'true' if using verified domain in Resend
EMAIL_FROM_VERIFIED=true

# -----------------------------------------------------------------------------
# NEXTAUTH CONFIGURATION
# -----------------------------------------------------------------------------
# Base URL of your application
NEXTAUTH_URL=https://afribit.africa

# Secret key for NextAuth.js session encryption
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here_generate_with_openssl

# -----------------------------------------------------------------------------
# GOOGLE OAUTH CONFIGURATION
# -----------------------------------------------------------------------------
# Google OAuth credentials (from Google Cloud Console)
# Required for admin Google login
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# -----------------------------------------------------------------------------
# OPENSTREETMAP CONFIGURATION
# -----------------------------------------------------------------------------
# OSM API endpoint (use dev instance for testing)
# Production: https://api.openstreetmap.org/api/0.6
# Development: https://api.dev.openstreetmap.org/api/0.6
OSM_API_URL=https://api.openstreetmap.org/api/0.6

# OSM OAuth credentials (from https://www.openstreetmap.org/oauth2/applications)
OSM_CLIENT_ID=your_osm_client_id_here
OSM_CLIENT_SECRET=your_osm_client_secret_here

# OSM Access Token (OAuth 2.0 token for API authentication)
# Generate after setting up OAuth app
OSM_ACCESS_TOKEN=your_osm_access_token_here

# -----------------------------------------------------------------------------
# DEVELOPMENT & DEBUGGING
# -----------------------------------------------------------------------------
# Node environment (development, production, test)
NODE_ENV=production

# Enable detailed debug logs (set to 'true' only in development)
ENABLE_DEBUG_LOGS=false

# -----------------------------------------------------------------------------
# BASE URL (LEGACY - for token generation)
# -----------------------------------------------------------------------------
# Used by token generator utility
NEXT_PUBLIC_BASE_URL=https://afribit.africa

# =============================================================================
# OPTIONAL: INTEGRATIONS
# =============================================================================

# -----------------------------------------------------------------------------
# SENTRY ERROR TRACKING
# -----------------------------------------------------------------------------
# Sentry DSN for error tracking and performance monitoring
# Get from https://sentry.io after creating a project
NEXT_PUBLIC_SENTRY_DSN=https://your_sentry_dsn_here@sentry.io/your_project_id

# Sentry organization and project (for releases)
SENTRY_ORG=your_sentry_org
SENTRY_PROJECT=your_sentry_project

# Sentry auth token (for uploading source maps)
SENTRY_AUTH_TOKEN=your_sentry_auth_token

# -----------------------------------------------------------------------------
# UPSTASH REDIS (For production rate limiting)
# -----------------------------------------------------------------------------
# Sign up at https://upstash.com and create a Redis database
# Get these values from the Redis database details page
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here

# Note: If these are not set, the application will fall back to in-memory rate limiting
# In-memory rate limiting works for development but won't scale in production

# =============================================================================
# SETUP CHECKLIST
# =============================================================================
# [ ] Set up MySQL database and configure DATABASE_URL
# [ ] Create BTCPay Server store and generate API key
# [ ] Sign up for Resend and create API key
# [ ] Configure Google OAuth credentials in Google Cloud Console
# [ ] Set up OpenStreetMap OAuth application
# [ ] Generate NEXTAUTH_SECRET with: openssl rand -base64 32
# [ ] Configure SMTP settings (if using email fallback)
# [ ] Set admin notification email address
# [ ] Update NEXTAUTH_URL and NEXT_PUBLIC_SITE_URL to your domain
# [ ] (Optional) Set up Sentry for error tracking
# [ ] (Optional) Configure Upstash Redis for production rate limiting
# =============================================================================
