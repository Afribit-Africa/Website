# Application
NEXT_PUBLIC_SITE_URL="https://www.afribit.africa"
# Google Search Console HTML tag token for URL-prefix verification.
# Paste only the token value from the content attribute, not the full meta tag.
GOOGLE_SITE_VERIFICATION=""
ADMIN_EMAIL=""

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/afribit"
DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/afribit"

# BTCPay Server
# Leave checkout off while the site uses the static Lightning donation page.
BTCPAY_CHECKOUT_ENABLED="false"
BTCPAY_HOST="https://btcpay.example.com"
BTCPAY_STORE_ID=""
BTCPAY_API_KEY=""
BTCPAY_WEBHOOK_SECRET=""

# Temporary/static donation fallback
NEXT_PUBLIC_DONATION_PAY_URL="https://pay.blink.sv/afribit/print"
NEXT_PUBLIC_DONATION_LIGHTNING_ADDRESS="afribit@blink.sv"
NEXT_PUBLIC_DONATION_QR_VALUE="afribit@blink.sv"

# Email
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="info@example.com"

# hCaptcha
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=""
HCAPTCHA_SECRET_KEY=""

# Opt in only after confirming Redis is healthy. Errors then fail closed.
PUBLIC_FORM_REDIS_ENABLED="false"
# Distributed public-form limits (optional pair; both required when enabled)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# OpenStreetMap merchant onboarding
# Server-only. Keep real values in .env.local and Vercel project env vars.
OSM_CLIENT_ID=""
OSM_CLIENT_SECRET=""
OSM_REDIRECT_URI="https://afribit.africa/api/auth/osm/callback"
OSM_ONBOARDING_ENABLED="false"
OSM_ONBOARDING_STATE_SECRET=""
OSM_ONBOARDING_ACCESS_TOKEN=""
